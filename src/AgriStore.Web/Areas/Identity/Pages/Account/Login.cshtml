@page
@model AgriStore.Web.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign in";
    ViewData["Auth"] = true;
}
<div class="auth">
    <section class="auth-story" data-rain>
        <h1 data-split>Welcome back to the godown.</h1>
        <p data-reveal>Sign in to see which lots need moving today, and what the sensors have said since you last looked.</p>
    </section>
    <section class="auth-form">
        <form method="post" class="form-card" asp-route-returnUrl="@Model.ReturnUrl" novalidate data-reveal>
            <h2 class="h2" style="margin-bottom: 24px">Sign in</h2>
            <div asp-validation-summary="ModelOnly" role="alert"></div>
            <div class="stack" style="gap: 20px">
                <div class="field">
                    <label asp-for="Input.Email">Email</label>
                    <input asp-for="Input.Email" autocomplete="username" inputmode="email" />
                    <span asp-validation-for="Input.Email" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.Password">Password</label>
                    <input asp-for="Input.Password" autocomplete="current-password" />
                    <span asp-validation-for="Input.Password" class="field-error"></span>
                </div>
                <label class="check"><input asp-for="Input.RememberMe" /> Keep me signed in</label>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn--primary">Sign in</button>
                <a class="link" asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Create an account</a>
            </div>
            <p class="demo-note">Demo admin: <strong>admin@agristore.local</strong> with password <strong>Admin@123</strong>.</p>
        </form>
    </section>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
