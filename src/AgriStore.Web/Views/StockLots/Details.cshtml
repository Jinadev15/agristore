@model LotWithRisk
@{
    var lot = Model.Lot;
    var crop = lot.Crop!;
    ViewData["Title"] = $"{crop.Name} lot #{lot.Id}";
}
<div class="page-head">
    <div>
        <h1 class="page-title">@lot.QuantityTonnes.ToString("0.#") t @crop.Name from @lot.FarmerName</h1>
        <p class="muted">Lot #@lot.Id in <a asp-controller="StorageUnits" asp-action="Details" asp-route-id="@lot.StorageUnitId">@lot.StorageUnit!.Name</a>, stored on @lot.StoredOn.ToString("d MMM yyyy"). Status: @lot.Status.</p>
    </div>
    <div class="actions">
        <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@lot.Id">Edit</a>
        @if (lot.Status == LotStatus.Stored)
        {
            <form asp-action="SetStatus" asp-route-id="@lot.Id" method="post"><input type="hidden" name="status" value="Dispatched" /><button class="btn btn-primary">Mark dispatched</button></form>
            <form asp-action="SetStatus" asp-route-id="@lot.Id" method="post" onsubmit="return confirm('Record this lot as spoiled?')"><input type="hidden" name="status" value="Spoiled" /><button class="btn btn-outline-danger">Mark spoiled</button></form>
        }
        @if (User.IsInRole(DbSeeder.AdminRole))
        {
            <form asp-action="Delete" asp-route-id="@lot.Id" method="post" onsubmit="return confirm('Delete this record permanently?')"><button class="btn btn-outline-danger">Delete</button></form>
        }
    </div>
</div>

<div class="row g-4">
    <section class="col-md-7">
        <div class="panel verdict edge-@Model.Risk.Level.ToString().ToLower()">
            <div class="d-flex justify-content-between align-items-start">
                <h2>Spoilage risk</h2>
                <partial name="_RiskBadge" model="Model.Risk" />
            </div>
            <p class="advice big">@Model.Risk.Recommendation</p>
            @if (Model.Risk.Reasons.Count > 0)
            {
                <h3>Why</h3>
                <ul class="reasons">@foreach (var r in Model.Risk.Reasons) { <li>@r</li> }</ul>
            }
            <h3>Shelf life</h3>
            <partial name="_ShelfBar" model="Model" />
        </div>
    </section>
    <section class="col-md-5">
        <div class="panel">
            <h2>Safe range for @crop.Name</h2>
            <dl class="pairs">
                <dt>Temperature</dt><dd>@crop.MinTempC to @crop.MaxTempC °C</dd>
                <dt>Humidity</dt><dd>@crop.MinHumidity to @crop.MaxHumidity %</dd>
                <dt>Shelf life</dt><dd>@crop.ShelfLifeDays days</dd>
            </dl>
        </div>
    </section>
</div>
