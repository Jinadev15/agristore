@model StockLot
@{ ViewData["Title"] = Model.Id == 0 ? "Record new lot" : $"Edit lot #{Model.Id}"; }
<h1 class="page-title">@ViewData["Title"]</h1>
<form asp-action="Save" method="post" class="form-panel">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Status" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3"><label asp-for="FarmerName" class="form-label"></label><input asp-for="FarmerName" class="form-control" /><span asp-validation-for="FarmerName" class="text-danger"></span></div>
    <div class="row">
        <div class="col-sm-6 mb-3"><label asp-for="CropProfileId" class="form-label"></label><select asp-for="CropProfileId" asp-items="ViewBag.Crops" class="form-select"><option value="">Choose a crop</option></select><span asp-validation-for="CropProfileId" class="text-danger"></span></div>
        <div class="col-sm-6 mb-3"><label asp-for="StorageUnitId" class="form-label"></label><select asp-for="StorageUnitId" asp-items="ViewBag.Units" class="form-select"><option value="">Choose a unit</option></select><span asp-validation-for="StorageUnitId" class="text-danger"></span></div>
    </div>
    <div class="row">
        <div class="col-sm-6 mb-3"><label asp-for="QuantityTonnes" class="form-label"></label><input asp-for="QuantityTonnes" class="form-control" /><span asp-validation-for="QuantityTonnes" class="text-danger"></span></div>
        <div class="col-sm-6 mb-3"><label asp-for="StoredOn" class="form-label"></label><input asp-for="StoredOn" class="form-control" /><span asp-validation-for="StoredOn" class="text-danger"></span></div>
    </div>
    <button class="btn btn-primary">Save lot</button>
    <a class="btn btn-link" asp-action="Index">Cancel</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
