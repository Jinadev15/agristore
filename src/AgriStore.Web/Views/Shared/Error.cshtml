@model ErrorViewModel
@{ ViewData["Title"] = "Something went wrong"; }
<section class="band band--indigo">
    <div class="wrap">
        <div class="status-code" aria-hidden="true">500</div>
        <h1 class="page-title" style="margin-top: 28px">Something went wrong</h1>
        <p class="page-sub">The server could not finish this request. Go back and try again.</p>
        @if (!string.IsNullOrEmpty(Model?.RequestId)) { <p class="page-sub">Reference: <code>@Model.RequestId</code></p> }
        <div class="actions" style="margin-top: 32px"><a class="btn btn--primary" href="/">Go to the home page</a></div>
    </div>
</section>
