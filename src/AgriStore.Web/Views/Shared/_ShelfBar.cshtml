@model LotWithRisk
@{
    var total = Model.Lot.Crop!.ShelfLifeDays;
    var used = Math.Clamp(total - Model.Risk.DaysLeft, 0, total);
    var pct = total == 0 ? 100 : Math.Round(100.0 * used / total);
}
<div class="bar bar--@Model.Risk.Level.ToString().ToLowerInvariant()" role="img" aria-label="@used of @total shelf-life days used">
    <span data-bar-to="@pct" style="width:@pct%"></span>
</div>
<div class="bar-caption">
    @if (Model.Risk.DaysLeft > 0) { <text>@Model.Risk.DaysLeft of @total days left</text> }
    else { <text>@(-Model.Risk.DaysLeft) days past shelf life</text> }
</div>
