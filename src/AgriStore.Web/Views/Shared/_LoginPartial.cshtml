@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

@if (SignInManager.IsSignedIn(User))
{
    <a class="user-chip" asp-area="Identity" asp-page="/Account/Manage/Index" title="Your account">@User.Identity?.Name</a>
    @if (User.IsInRole(DbSeeder.AdminRole)) { <span class="role-tag">Admin</span> }
    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post">
        <button type="submit" class="btn btn--ghost btn--small">Sign out</button>
    </form>
}
else
{
    <a class="user-chip" asp-area="Identity" asp-page="/Account/Login">Sign in</a>
    <a class="btn btn--primary btn--small" asp-area="Identity" asp-page="/Account/Register">Create account</a>
}
