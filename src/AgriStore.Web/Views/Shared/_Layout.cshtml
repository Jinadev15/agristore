@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var isLanding = ViewData["Landing"] is true;
    // Identity's own "Manage account" pages are not restyled page by page: wrap them and map their class names.
    var identityCompat = ViewContext.RouteData.Values["area"]?.ToString() == "Identity" && ViewData["Auth"] is not true;
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    string On(string name) => controller == name ? "on" : "";
}
<!DOCTYPE html>
<html lang="en-IN" class="no-js">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1F2A5C" />
    <meta name="description" content="AgriStore watches temperature, humidity and shelf life in every storage unit and tells you which lot to move before it spoils." />
    <title>@(ViewData["Title"] is string t && t.Length > 0 ? $"{t} · AgriStore" : "AgriStore")</title>
    <script>
        (function () {
            var d = document.documentElement;
            d.classList.remove("no-js");
            if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
            d.classList.add("js-motion");
            @if (isLanding)
            {
                <text>try { if (!sessionStorage.getItem("agristore-intro")) { d.classList.add("first-visit"); sessionStorage.setItem("agristore-intro", "1"); } } catch (e) { }</text>
            }
            // Safety net: if the motion script never loads, show everything.
            setTimeout(function () { if (!d.classList.contains("motion-ready")) d.classList.remove("js-motion", "first-visit"); }, 3000);
        })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT@9..144,300..900,100&family=Instrument+Sans:wght@400;500;600&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%231F2A5C'/%3E%3Cpath d='M16 6c-5 6-5 11 0 16 5-5 5-10 0-16Zm0 16v5' fill='none' stroke='%23F2A007' stroke-width='2.4' stroke-linecap='round'/%3E%3C/svg%3E" />
</head>
<body class="@(identityCompat ? "identity-compat" : "")">
    <a class="skip-link" href="#main">Skip to content</a>
    @if (isLanding)
    {
        <div class="curtain" aria-hidden="true"><span>AgriStore</span></div>
    }

    <header class="site-header">
        <div class="wrap">
            <a class="brand" href="@(signedIn ? "/Dashboard" : "/")">
                <svg width="28" height="28" viewBox="0 0 28 28" aria-hidden="true"><path d="M14 3c-5 6-5 11 0 16 5-5 5-10 0-16Zm0 16v6M7 13c0 5 3 7 7 7M21 13c0 5-3 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
                AgriStore
            </a>
            <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Menu"><span></span><span></span><span></span></button>

            <nav class="nav" id="site-nav" aria-label="Main">
                @if (signedIn && !isLanding)
                {
                    <a class="@On("Dashboard")" href="/Dashboard">Overview</a>
                    <a class="@On("StockLots")" asp-controller="StockLots" asp-action="Index">Stock</a>
                    <a class="@On("StorageUnits")" asp-controller="StorageUnits" asp-action="Index">Storage units</a>
                    <a class="@On("Readings")" asp-controller="Readings" asp-action="Index">Readings</a>
                    <a class="@On("Crops")" asp-controller="Crops" asp-action="Index">Crops</a>
                }
                else if (isLanding)
                {
                    <a href="#story">The problem</a>
                    <a href="#steps">How it works</a>
                    <a href="#guide">Crop guide</a>
                    <a href="/swagger">API</a>
                }
                <span class="nav-ink" aria-hidden="true"></span>
            </nav>

            <div class="header-tools">
                @if (signedIn)
                {
                    <button class="kbd-btn" type="button" data-cmdk>Search <kbd>Ctrl K</kbd></button>
                }
                <partial name="_LoginPartial" />
            </div>
        </div>
    </header>

    <main id="main" tabindex="-1">
        @if (IsSectionDefined("Band"))
        {
            <section class="band band--indigo page-band">
                <div class="wrap">@RenderSection("Band")</div>
            </section>
        }
        @if (identityCompat)
        {
            <section class="band band--indigo page-band"><div class="wrap"><h1 class="page-title">Your account</h1></div></section>
            <div class="wrap content"><div class="form-card" style="max-width: none">@RenderBody()</div></div>
        }
        else
        {
            @RenderBody()
        }
    </main>

    <div class="toasts" aria-live="polite">
        @if (TempData["Message"] is string message)
        {
            <div class="toast" role="status"><p>@message</p><button type="button" aria-label="Dismiss">✕</button><span class="timer"></span></div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="toast toast--error" role="alert"><p>@error</p><button type="button" aria-label="Dismiss">✕</button><span class="timer"></span></div>
        }
    </div>

    @if (signedIn)
    {
        <dialog class="cmdk" id="cmdk" aria-label="Search pages, lots and storage units">
            <input type="search" placeholder="Search pages, lots, farmers, units" aria-label="Search" autocomplete="off" />
            <ul role="listbox"></ul>
        </dialog>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/app.js" asp-append-version="true"></script>
    <script src="~/js/motion.js" asp-append-version="true"></script>
</body>
</html>
