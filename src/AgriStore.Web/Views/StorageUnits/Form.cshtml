@model StorageUnit
@{ ViewData["Title"] = Model.Id == 0 ? "Add storage unit" : $"Edit {Model.Name}"; }
@section Band {
    <nav class="crumbs" aria-label="Breadcrumb"><a class="link" asp-action="Index">Storage units</a><span aria-hidden="true">/</span><span>@(Model.Id == 0 ? "New" : Model.Name)</span></nav>
    <h1 class="page-title" data-split>@ViewData["Title"]</h1>
}
<section class="content">
    <div class="wrap">
        <form asp-action="Save" method="post" class="form-card" data-reveal>
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" role="alert"></div>
            <div class="form-grid">
                <div class="field"><label asp-for="Name">Name</label><input asp-for="Name" maxlength="80" /><span asp-validation-for="Name" class="field-error"></span></div>
                <div class="field"><label asp-for="Location">Location</label><input asp-for="Location" placeholder="Town, State" maxlength="120" /><span asp-validation-for="Location" class="field-error"></span></div>
                <div class="field"><label asp-for="Type">Type</label><select asp-for="Type" asp-items="Html.GetEnumSelectList<StorageType>()"></select></div>
                <div class="field"><label asp-for="CapacityTonnes">Capacity (tonnes)</label><input asp-for="CapacityTonnes" type="number" min="1" step="any" inputmode="decimal" /><span asp-validation-for="CapacityTonnes" class="field-error"></span></div>
            </div>
            <div class="form-actions">
                <button class="btn btn--primary" type="submit">Save storage unit</button>
                <a class="link" href="@(Model.Id == 0 ? Url.Action("Index") : Url.Action("Details", new { id = Model.Id }))">Cancel</a>
            </div>
        </form>
    </div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
