@model StorageUnit
@{ ViewData["Title"] = Model.Id == 0 ? "Add storage unit" : $"Edit {Model.Name}"; }
<h1 class="page-title">@ViewData["Title"]</h1>
<form asp-action="Save" method="post" class="form-panel">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Location" class="form-label"></label><input asp-for="Location" class="form-control" placeholder="Town, State" /><span asp-validation-for="Location" class="text-danger"></span></div>
    <div class="row">
        <div class="col-sm-6 mb-3"><label asp-for="Type" class="form-label"></label><select asp-for="Type" asp-items="Html.GetEnumSelectList<StorageType>()" class="form-select"></select></div>
        <div class="col-sm-6 mb-3"><label asp-for="CapacityTonnes" class="form-label"></label><input asp-for="CapacityTonnes" class="form-control" /><span asp-validation-for="CapacityTonnes" class="text-danger"></span></div>
    </div>
    <button class="btn btn-primary">Save storage unit</button>
    <a class="btn btn-link" asp-action="Index">Cancel</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
