@model List<UnitStatus>
@{ ViewData["Title"] = "Storage units"; }
<div class="page-head">
    <h1 class="page-title">Storage units</h1>
    @if (User.IsInRole(DbSeeder.AdminRole))
    {
        <a class="btn btn-primary" asp-action="Create">Add storage unit</a>
    }
</div>
@if (Model.Count == 0) { <p class="empty">No storage units yet. An admin can add the first one.</p> }
<div class="table-responsive">
<table class="table data">
    <thead><tr><th>Name</th><th>Type</th><th>Location</th><th class="num">Filled</th><th class="num">Latest reading</th><th></th></tr></thead>
    <tbody>
    @foreach (var s in Model)
    {
        <tr>
            <td><a asp-action="Details" asp-route-id="@s.Unit.Id">@s.Unit.Name</a></td>
            <td>@s.Unit.Type.Label()</td>
            <td>@s.Unit.Location</td>
            <td class="num">@s.StoredTonnes.ToString("#,0.#") / @s.Unit.CapacityTonnes.ToString("#,0") t (@s.FillPercent%)</td>
            <td class="num">@(s.Latest is null ? "None" : $"{s.Latest.TemperatureC:0.#}°C, {s.Latest.HumidityPercent:0}%")</td>
            <td>@if (s.LotsOutOfRange > 0) { <span class="tag-warn">@s.LotsOutOfRange out of range</span> }</td>
        </tr>
    }
    </tbody>
</table>
</div>
