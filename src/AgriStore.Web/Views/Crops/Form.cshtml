@model CropProfile
@{ ViewData["Title"] = Model.Id == 0 ? "Add crop" : $"Edit {Model.Name}"; }
<h1 class="page-title">@ViewData["Title"]</h1>
<form asp-action="Save" method="post" class="form-panel">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
    <div class="row">
        <div class="col-sm-6 mb-3"><label asp-for="MinTempC" class="form-label"></label><input asp-for="MinTempC" class="form-control" step="0.5" /></div>
        <div class="col-sm-6 mb-3"><label asp-for="MaxTempC" class="form-label"></label><input asp-for="MaxTempC" class="form-control" step="0.5" /><span asp-validation-for="MaxTempC" class="text-danger"></span></div>
        <div class="col-sm-6 mb-3"><label asp-for="MinHumidity" class="form-label"></label><input asp-for="MinHumidity" class="form-control" /><span asp-validation-for="MinHumidity" class="text-danger"></span></div>
        <div class="col-sm-6 mb-3"><label asp-for="MaxHumidity" class="form-label"></label><input asp-for="MaxHumidity" class="form-control" /><span asp-validation-for="MaxHumidity" class="text-danger"></span></div>
    </div>
    <div class="mb-3"><label asp-for="ShelfLifeDays" class="form-label"></label><input asp-for="ShelfLifeDays" class="form-control" /><span asp-validation-for="ShelfLifeDays" class="text-danger"></span></div>
    <button class="btn btn-primary">Save crop</button>
    <a class="btn btn-link" asp-action="Index">Cancel</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
